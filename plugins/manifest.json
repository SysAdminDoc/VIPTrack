{
  "schemaVersion": 2,
  "name": "VIPTrack optional plugins and overlays",
  "description": "Explicitly opt-in, same-origin extensions for analyst annotation.",
  "plugins": [
    {
      "id": "awacs-orbit-template",
      "kind": "geojson-preset",
      "name": "AWACS orbit template",
      "description": "Illustrative racetrack for annotating an AWACS/E-3/E-7 pattern.",
      "presetId": "awacs-orbit-template",
      "geojson": "../data/overlays/mil-patterns.geojson",
      "requiresOptIn": true,
      "verified": false,
      "version": "1.0.0",
      "origin": "same-origin",
      "license": "MIT",
      "dataClasses": ["public-geometry"],
      "capabilities": ["overlay.geojson"],
      "approvedCapabilities": ["overlay.geojson"],
      "cleanupHook": "deactivate"
    },
    {
